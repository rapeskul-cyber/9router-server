# Copy to .env and fill in. NEVER commit the real .env.
# Hugging Face token for the public status panel + private DB backup.
# Leave empty to run with no panel/backup (tunnel + app still work).
HF_TOKEN=

*** HF Space (static) that renders status.json
PANEL_REPO=sekenhwu/9router-static

# HF private dataset receiving hourly DB backups (branch must exist)
BACKUP_REPO=sekenhwu/9router-backup

# 1 = start a cloudflared quick tunnel, 0 = only listen on PORT
ENABLE_TUNNEL=1

PORT=20128
